# Copy to site/.env.local and fill in. Never commit real values.
# All server-only: none of these may be prefixed with NEXT_PUBLIC_.

# Cloudflare D1 — lead and CRM database
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# R2 object storage — brochures, floor plans, lead attachments
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
R2_BUCKET=

# Search engines. Read server-side, so no NEXT_PUBLIC_ prefix.
# Leave unset (or anything but "true") and every page ships noindex, which is
# what you want until prices, areas and the completion date are approved.
SITE_INDEXABLE=false
SITE_URL=
